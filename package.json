{
  "name": "dsh-coin-ticker",
  "version": "0.1.1",
  "description": "DSH 侧边栏行情卡片：BTC / ETH / SOL，可收成一枚小胶囊，零依赖零密钥。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "crypto",
    "ticker",
    "sidebar"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "https.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "tests"
  ],
  "scripts": {
    "test": "node tests/smoke.mjs",
    "test:live": "node tests/live.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxhsjxhs/dsh-coin-ticker.git"
  },
  "homepage": "https://github.com/jxhsjxhs/dsh-coin-ticker#readme",
  "bugs": {
    "url": "https://github.com/jxhsjxhs/dsh-coin-ticker/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "node": ">=22.19"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-coin-ticker",
    "summary": "侧边栏行情卡片：BTC / ETH / SOL 的价格、24h 涨跌与迷你走势，点一下收成一枚小胶囊不占位置。零依赖、免密钥，自动适配系统代理。",
    "categories": [
      "行情",
      "Web UI"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "node": ">=22.19"
    },
    "permissions": {
      "network": [
        "https://www.okx.com",
        "https://api.binance.com",
        "https://api.coingecko.com"
      ]
    }
  }
}
